# Canton Resonance 2.0 - Environment Variables

# --- PRODUCTION SETTINGS ---
# Set these if you are connecting to a live Canton network (e.g., Canton DevNet)
CANTON_JSON_API_URL="https://api.your-canton-node.com"
CANTON_JWT_TOKEN="your-signed-jwt-token"
CANTON_PARTY_ID="your-party-id"

# --- LOCAL DEVELOPMENT ---
# For local testing with `daml start`, you don't need to set the variables above.
# The app will default to http://localhost:7575 and use unsigned sandbox tokens.

# PORT for the Node server (default: 3000)
PORT=3000
