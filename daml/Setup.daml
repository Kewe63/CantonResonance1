module Setup where

import Daml.Script
import Ticket
import Asset

-- | Production-ready setup script for Canton Ticket Platform.
-- Creates parties, users, and seed data for the ledger.
setup : Script ()
setup = script do
  -- ═══ Allocate Parties ═══
  organizer <- allocatePartyWithHint "Organizer" (PartyIdHint "Organizer")
  artist    <- allocatePartyWithHint "Artist"    (PartyIdHint "Artist")
  alice     <- allocatePartyWithHint "Alice"     (PartyIdHint "Alice")
  bob       <- allocatePartyWithHint "Bob"       (PartyIdHint "Bob")
  public    <- allocatePartyWithHint "Public"    (PartyIdHint "Public")

  -- ═══ Create Ledger Users ═══
  orgUser <- validateUserId "organizer"
  createUser (User orgUser (Some organizer)) [CanActAs organizer]

  artistUser <- validateUserId "artist"
  createUser (User artistUser (Some artist)) [CanActAs artist]

  aliceUser <- validateUserId "alice"
  createUser (User aliceUser (Some alice)) [CanActAs alice, CanReadAs public]

  bobUser <- validateUserId "bob"
  createUser (User bobUser (Some bob)) [CanActAs bob, CanReadAs public]

  publicUser <- validateUserId "public"
  createUser (User publicUser (Some public)) [CanActAs public, CanReadAs public]

  -- ═══ Seed: Create Initial Event ═══
  evId <- submit organizer do
    createCmd Event with
      organizer   = organizer
      artist      = artist
      public      = public
      name        = "Istanbul Konseri 2025"
      date        = "15 Eylul 2025"
      venue       = "Zorlu PSM"
      totalTickets = 100
      price       = 50.0
      royaltyPct  = 15.0
      ticketsSold = 0
      maxResaleMultiplier = Some 3.0
      isCancelled = False

  -- Second event
  submit organizer do
    createCmd Event with
      organizer   = organizer
      artist      = artist
      public      = public
      name        = "Antalya Caz Festivali"
      date        = "3 Ekim 2025"
      venue       = "Aspendos Amfitiyatrosu"
      totalTickets = 250
      price       = 35.0
      royaltyPct  = 12.0
      ticketsSold = 0
      maxResaleMultiplier = Some 2.5
      isCancelled = False

  -- Third event
  submit organizer do
    createCmd Event with
      organizer   = organizer
      artist      = artist
      public      = public
      name        = "Ankara Rock Gecesi"
      date        = "22 Kasim 2025"
      venue       = "Congresium"
      totalTickets = 150
      price       = 45.0
      royaltyPct  = 10.0
      ticketsSold = 0
      maxResaleMultiplier = None
      isCancelled = False

  -- ═══ Seed: Mint USDC tokens for users ═══
  -- Organizer mints USDC for Alice and Bob
  submit organizer do
    createCmd Asset with
      issuer   = organizer
      owner    = organizer
      currency = "USDC"
      amount   = 10000.0

  -- Alice starts with 500 USDC
  aliceMintProposal <- submit organizer do
    createCmd AssetMintProposal with
      issuer   = organizer
      owner    = alice
      currency = "USDC"
      amount   = 500.0

  submit alice do
    exerciseCmd aliceMintProposal Accept_Mint

  -- Bob starts with 500 USDC
  bobMintProposal <- submit organizer do
    createCmd AssetMintProposal with
      issuer   = organizer
      owner    = bob
      currency = "USDC"
      amount   = 500.0

  submit bob do
    exerciseCmd bobMintProposal Accept_Mint

  -- ═══ Demo: Alice buys a ticket ═══
  (updatedEvId, aliceTicketId) <- submitMulti [alice] [public] do
    exerciseCmd evId BuyTicket with
      buyer = alice
      seat  = "A-12"

  -- ═══ Demo: Alice lists for secondary sale ═══
  listingId <- submit alice do
    exerciseCmd aliceTicketId ListForSale with
      sellPrice = 80.0

  -- ═══ Demo: Bob buys from secondary market ═══
  (bobTicketId, royaltyReceiptId) <- submitMulti [bob] [public] do
    exerciseCmd listingId BuySecondary with
      newOwner = bob

  return ()
